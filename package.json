{
  "name": "codeflow-agent",
  "version": "0.1.0",
  "description": "A transparent, traceable local coding agent for Windows.",
  "private": true,
  "type": "module",
  "bin": {
    "codeflow": "./dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "dev": "tsx src/cli/index.ts",
    "eval:fixtures": "tsx src/eval/fixture-cli.ts",
    "start": "node dist/cli/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.20.0",
  "dependencies": {
    "commander": "^15.0.0",
    "ink": "^7.1.1",
    "openai": "^7.4.0",
    "react": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@vitest/coverage-v8": "^4.1.10",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
