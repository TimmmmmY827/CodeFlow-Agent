+package labels
+
+import (
+	"fmt"
+	"strings"
+)
+
+func Parse(values []string) (map[string]string, error) {
+	result := make(map[string]string, len(values))
+	for _, value := range values {
+		key, parsedValue, found := strings.Cut(value, "=")
+		key = strings.TrimSpace(key)
+		parsedValue = strings.TrimSpace(parsedValue)
+		if !found || key == "" {
+			return nil, fmt.Errorf("invalid label %q", value)
+		}
+		result[key] = parsedValue
+	}
+	return result, nil
+}
