@@ -0,0 +1,6 @@
+def word_frequencies(text: str) -> dict[str, int]:
+    """Count whitespace-separated words."""
+    frequencies: dict[str, int] = {}
+    for word in text.lower().split():
+        frequencies[word] = frequencies.get(word, 0) + 1
+    return frequencies
